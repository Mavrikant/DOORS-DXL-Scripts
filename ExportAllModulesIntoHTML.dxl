string getBaselineStr(Baseline bLine)
{
  if (bLine != null) return major (bLine) "" "." minor (bLine) ""
  else               return "current"
}

void addHTMLFooter() {
  Module currMod = thisModule
  Baseline bLine = getMostRecentBaseline(currMod)
  ob += (NLS_("<p><DIV align=\"center\" style=\"color: grey;font-size: small;\">"))
  ob += (NLS_("Module: "fullName(currMod) " (Baseline " getBaselineStr(bLine) ")\n</br>"))
  ob += (NLS_("Export time: " stringOf(dateAndTime(today) , "yyyy-MM-dd" ) "\n</br></br></br>"))
  ob += (NLS_("Generator: </br>"))
  ob += (NLS_("Version: " ScriptVersion "</br>"))
  ob += (NLS_("<a href = \"https://github.com/Mavrikant/DOORS-DXL-Scripts\">Mavrikant/DOORS-DXL-Scripts</a>"))
  ob += (NLS_("</DIV></p>"))
  writeHTMLtoFile()
}

