// htmlText writes the bullets of rich text lists as <img src=bullet.gif> tags. They are replaced by a Unicode bullet,
// so the image file does not have to be copied next to every exported module.
const string BULLET_CHAR = "•&nbsp;"
Regexp reBulletImg = regexp2 "<[iI][mM][gG][^>]*bullet.gif[^>]*>"

void replaceBulletImages() {
  int from = 0
  int len  = length ob
  Buffer res = null
  while ((from < len) && search(reBulletImg, ob, from))
  {
    if (null res) res = create
    int first = start 0
    int last  = end 0
    if (first > 0) res += ob[from : from + first - 1]
    res += BULLET_CHAR
    from += last + 1
  }
  if (null res) return
  if (from < len) res += ob[from : len - 1]
  setempty ob
  ob += res
  delete res
}

void flushHTML() {
  replaceBulletImages()
  expFP << ob
  setempty ob
}

void writeHTMLtoFile() {
  // Writing to the file after every small append is slow, so the output is written in larger blocks.
  // flushHTML must be called before the file is closed.
  if (length(ob) >= FLUSH_SIZE) flushHTML()
}

string guessExportName(string dirName, string modName) {
  return dirName modName ".html"
}

void addHTMLHeader(string modName)  
{
  ob += (NLS_("<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01 Transitional//EN\" \"http://www.w3.org/TR/html4/loose.dtd\">"))
  ((((ob += (NLS_("<html>\n<head>\n<META HTTP-EQUIV="))) += QT) += (NLS_("Content-Type"))) += QT)
  (((((ob += (NLS_(" CONTENT=")))+= QT) += (NLS_("text/html; charset=UTF-8"))) += QT) += (NLS_(">\n")))
  ((ob += (NLS_("<title>"))) += modName) += (NLS_("</title>\n"))
  ob += (NLS_("<style>\n    * { box-sizing: border-box; }\n    a:link { text-decoration: none; }\n    a:visited { text-decoration: none; }\n    a:hover { text-decoration: none; }\n    a:active { text-decoration: none; }\n\n    #DoorsTable {\n        border-collapse: collapse;\n        width: 100%;\n        border: 1px solid #ddd;\n        font-size: 12px;\n        font-family: Verdana, Geneva, sans-serif; \n    }\n\n    #DoorsTable th,\n    #DoorsTable td {\n        text-align: left;\n    }\n\n    #DoorsTable tr:hover {\n        background-color: rgb(235, 243, 242);\n    }\n\n    #DoorsTable thead tr th {\n        font-weight: bold;\n        cursor: pointer;\n        background: rgb(0, 212, 160);\n    }\n\n    #DoorsTable thead tr th span {\n        background-repeat: no-repeat;\n        background-position: 100% 100%;\n    }\n    #DoorsTable thead tr:nth-child(1) th{\n        position: sticky;\n        top: -1px;\n        z-index: 10;\n    }\n    .dropdown-filter-dropdown {\n    position:relative;\n    display:inline-block;\n    }\n\n    .dropdown-filter-icon {\n        line-height:1.3;\n    }\n\n    .dropdown-filter-icon:hover {\n        cursor:pointer;\n    }\n\n    .checkbox-container {\n        max-height: 400px;\n        overflow-y: scroll;\n    }\n    .dropdown-filter-content {\n        display: none;\n        position: absolute;\n        background-color: rgb(206, 226, 221);\n        min-width: 200px;\n        box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);\n        z-index: 1;\n        padding-bottom:5px;\n        padding-top:5px;\n        padding-right:5px;\n        padding-left:5px;\n    }\n\n    .dropdown-filter-content div {\n        margin-top:5px;\n        margin-left:5px;\n        margin-right:5px;\n        margin-bottom:5px;\n    }\n\n    .dropdown-filter-content div.dropdown-filter-search {\n        margin-bottom:10px;\n        margin-top:10px;\n    }\n\n\n    .dropdown-filter-content div.dropdown-filter-sort {\n        padding-top:5px;\n        padding-bottom:5px;\n    }\n\n    .dropdown-filter-content div.dropdown-filter-sort:hover {\n        background-color:rgb(141, 226, 206);\n        cursor:pointer;\n    }\n\n    .dropdown-filter-content div.dropdown-filter-sort span {\n        margin-right:5px;\n        margin-left:5px;\n        margin-top:5px;\n        margin-bottom:5px;\n        color:#000000;\n    }\n\n    .arrow-down {\n        border: solid black;\n        border-width: 0 3px 3px 0;\n        display: inline-block;\n        padding: 3px;\n        margin-right:5px;\n        margin-left:5px;\n        transform: rotate(45deg);\n        -webkit-transform: rotate(45deg);\n    }\n    .out-link a {\n        color: rgb(176, 48, 96);\n    }\n    .out-link  {\n        color: rgb(176, 48, 96);\n    }\n    .in-link a {\n        color: rgb(255, 165, 0);\n    }\n    .in-link  {\n        color: rgb(255, 165, 0);\n    }\n</style>\n"))
  ob += (NLS_("<script type=\"text/javascript\" src=\"https://code.jquery.com/jquery-3.6.0.min.js\"></script>\n"))
  ob += (NLS_("<script type=\"text/javascript\" src=\"https://cdnjs.cloudflare.com/ajax/libs/colresizable/1.6.0/colResizable-1.6.min.js\"></script>\n"))
  ob += (NLS_("<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.0.0-alpha.6/css/bootstrap.min.css\" />\n"))
  ob += (NLS_("<script src=\"/excel-bootstrap-table-filter-bundle.js\"></script>\n"))
  // Large pictures are shown at a medium size; the viewer written by dumpCloser shows them enlarged
  string imgMaxWidth  = IMAGE_MAX_WIDTH ""
  string imgMaxHeight = IMAGE_MAX_HEIGHT ""
  ob += (NLS_("<style>\n"))
  ob += ("    #DoorsTable img { max-width: " imgMaxWidth "px; max-height: " imgMaxHeight "px; object-fit: contain; }\n")
  ob += (NLS_("    #DoorsTable img.zoomable { cursor: zoom-in; }\n"))
  ob += (NLS_("    #imageViewer { display: none; position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 10000; background: rgba(0, 0, 0, 0.8); align-items: center; justify-content: center; cursor: zoom-out; }\n"))
  ob += (NLS_("    #imageViewer.open { display: flex; }\n"))
  ob += (NLS_("    #imageViewer img { max-width: 95vw; max-height: 95vh; background: #fff; box-shadow: 0 0 24px rgba(0, 0, 0, 0.6); }\n"))
  ob += (NLS_("</style>\n"))
  ob += (NLS_("</head>\n"))
  ob += (NLS_("<BODY>\n"))
  writeHTMLtoFile()
} 

