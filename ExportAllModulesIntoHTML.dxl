void logError(string msg)
// DESCRIPTION : Errors are printed instead of shown in a dialog box. A dialog stops the export until
//               someone clicks it, and nobody can click it in batch mode.
{
  print "ERROR: " msg "\n"
}

bool progressCheck(string msg)
// DESCRIPTION : Shows msg in the progress window. Updating the window also keeps DOORS responsive.
// RETURNS : true if the user has clicked Cancel
{
  if (null progressDB) return false
  progressMessage(msg)
  if (progressCancelled()) exportCancelled = true
  return exportCancelled
}

string exportPathOf(string doorsPath)
// DESCRIPTION : Converts a DOORS path such as "/Project/Folder" into the matching directory below exportRoot.
{
  Buffer b = create
  b = exportRoot
  int i
  for (i = 0; i < length(doorsPath); i++)
  {
    char c = doorsPath[i]
    if (c == '/')
    {
      if (i < length(doorsPath) - 1) b += '\\'
    }
    else
    {
      b += c
    }
  }
  string s = stringOf(b)
  delete b
  return s
}

bool dirExists(string dirPath)
{
  Stat st = create dirPath
  if (null st) return false
  bool isDir = directory st
  delete st
  return isDir
}

void createDir(string dirPath)
// DESCRIPTION : mkdir halts the script when it fails, so its error is trapped and logged instead.
{
  noError()
  mkdir(dirPath)
  string err = lastError()
  if (!null err) logError("Cannot create folder " dirPath ": " err)
}

bool makeDirs(string dirPath)
// DESCRIPTION : Creates dirPath and its missing parent directories, from the top down.
// RETURNS : true if dirPath exists afterwards
{
  if (null dirPath) return false
  int i
  for (i = 1; i < length(dirPath); i++)
  {
    // "C:\" is a drive, not a directory
    if ((dirPath[i] == '\\') && (dirPath[i-1] != ':'))
    {
      string parentDir = dirPath[0:i-1]
      if (!dirExists(parentDir)) createDir(parentDir)
    }
  }
  if (!dirExists(dirPath)) createDir(dirPath)
  return dirExists(dirPath)
}

